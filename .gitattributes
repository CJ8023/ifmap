# 统一用 LF 入库（Windows 检出亦为 LF，避免 CRLF 抖动）
* text=auto eol=lf

*.java    text eol=lf
*.xml     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
LICENSE   text eol=lf
mvnw      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

*.jar   binary
*.zip   binary
*.png   binary
*.gif   binary
*.ico   binary
