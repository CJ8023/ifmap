<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>cn.cj</groupId>
  <artifactId>ifmap-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>ifmap-parent</name>
  <description>ifmap - Interface Mapping Engine: configuration-driven interface message mapping (template DSL + pluggable rules)</description>
  <url>https://github.com/CJ8023/ifmap</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>CJ8023</id>
      <name>caijun</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/CJ8023/ifmap.git</connection>
    <developerConnection>scm:git:git@github.com:CJ8023/ifmap.git</developerConnection>
    <url>https://github.com/CJ8023/ifmap</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>ifmap-core</module>
    <module>ifmap-json-jackson</module>
    <module>ifmap-json-fastjson</module>
    <module>ifmap-json-tck</module>
    <module>ifmap-provider-jdbc</module>
    <module>ifmap-demo-pure-java</module>
    <!-- Spring Boot 3 相关模块要求 JDK 17+，放在下面的 jdk17 剖面里 -->
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>8</maven.compiler.release>

    <slf4j.version>2.0.17</slf4j.version>
    <jackson.version>2.18.3</jackson.version>
    <json-path.version>2.10.0</json-path.version>
    <!-- fastjson 只被 ifmap-json-fastjson（兼容模块）依赖，starter 不引它。
         版本必须是 1.2.84：1.2.68~1.2.83 在默认配置下存在可被利用的 AutoType 反序列化 RCE，
         1.2.84 是官方 backport 的加固版（详见 docs/05-SpringBoot集成.md 的“换 JSON 实现”一节）。 -->
    <fastjson.version>1.2.84</fastjson.version>
    <junit.version>5.12.2</junit.version>
    <!-- provider-jdbc 用 spring-jdbc 的 JdbcTemplate（Q4 决策）：默认 5.3.x 兼容 JDK8 + Spring5。
         注意：该版本**只声明在 ifmap-provider-jdbc 模块内**，不放进本文件的 dependencyManagement
         —— 否则会覆盖 Spring Boot 3 传来的 spring-jdbc 6.2.x，导致 SB3 运行时 NoSuchMethodError。 -->
    <spring-jdbc.version>5.3.39</spring-jdbc.version>
    <h2.version>1.4.200</h2.version>

    <!-- 静态分析（W7）：只允许零误报的规则组作为构建门禁，见 spotbugs-exclude.xml 的逐条理由 -->
    <plugin.spotbugs.version>4.8.6.6</plugin.spotbugs.version>

    <!-- Spring Boot starter（仅 ifmap-spring-boot-starter / ifmap-demo-spring-boot3 使用，不影响其他模块） -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <caffeine.version>2.9.2</caffeine.version>

    <plugin.clean.version>3.4.1</plugin.clean.version>
    <plugin.resources.version>3.3.1</plugin.resources.version>
    <plugin.compiler.version>3.13.0</plugin.compiler.version>
    <plugin.surefire.version>3.5.6</plugin.surefire.version>
    <plugin.jar.version>3.4.2</plugin.jar.version>
    <plugin.install.version>3.1.4</plugin.install.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-json-jackson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-json-fastjson</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-json-tck</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-provider-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>cn.cj</groupId>
        <artifactId>ifmap-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.jayway.jsonpath</groupId>
        <artifactId>json-path</artifactId>
        <version>${json-path.version}</version>
      </dependency>
      <dependency>
        <groupId>com.alibaba</groupId>
        <artifactId>fastjson</artifactId>
        <version>${fastjson.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${plugin.clean.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${plugin.resources.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${plugin.compiler.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${plugin.surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${plugin.jar.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${plugin.install.version}</version>
        </plugin>
        <!--
          SpotBugs：绑定在 verify 阶段，随 `mvn verify` 一起跑（CI 矩阵的每个 JDK 都会跑到）。
          effort=Max + threshold=Medium：低优先级（Low）里噪声太多（多为风格建议），
          门禁只拦 Medium 及以上；被排除的项必须逐条写清理由，见根目录 spotbugs-exclude.xml。
          不分析测试代码（includeTests 默认 false）。
        -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${plugin.spotbugs.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <includeTests>false</includeTests>
            <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
            <failOnError>true</failOnError>
          </configuration>
          <executions>
            <execution>
              <id>spotbugs-check</id>
              <phase>verify</phase>
              <goals>
                <goal>check</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- 静态分析（SpotBugs）：本身见 pluginManagement；这里只负责在 JDK 11+ 上启用，
           因为 SpotBugs 4.8.x 运行时要求 Java 11（它仍能分析 Java 8 字节码，只是跑不起来在 JDK 8 上）。 -->
    </plugins>
  </build>

  <profiles>
    <!--
      静态分析：**只在 JDK 11+ 自动开启**。SpotBugs 4.8.x 自身要求 Java 11 才能运行
      （能分析 Java 8 字节码，但在 JDK 8 上跑不起来），所以 JDK 8 矩阵走 `<jdk>[11,)</jdk>`
      之外的分支 —— 这也是 CI 矩阵里 8 号位不跑 spotbugs 的原因。

      绑定 verify 阶段：`mvn clean verify` 即含静态分析；临时跳过用 -Dspotbugs.skip=true。
      排除清单（每条带理由）见根目录 spotbugs-exclude.xml。
    -->
    <profile>
      <id>static-analysis</id>
      <activation>
        <jdk>[11,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Spring Boot 3 需要 JDK 17。用剖面按 JDK 版本自动装/卸模块，这样 JDK 8/11 上
      执行 mvn test 不会因为 starter 的 release=17 而失败（CI 矩阵见 .github/workflows/ci.yml）。
    -->
    <profile>
      <id>spring-boot3</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <modules>
        <module>ifmap-spring-boot-starter</module>
        <module>ifmap-admin-spring-boot-starter</module>
        <module>ifmap-demo-spring-boot3</module>
      </modules>
    </profile>
  </profiles>
</project>
