<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.cj</groupId>
    <artifactId>ifmap-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ifmap-spring-boot-starter</artifactId>
  <name>ifmap-spring-boot-starter</name>
  <description>ifmap 的 Spring Boot 3 自动配置（仅支持 jakarta 命名空间 / JDK 17+）</description>

  <properties>
    <!-- Spring Boot 3 要求 JDK 17；core 仍是 Java 8 字节码，二者不冲突 -->
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>cn.cj</groupId>
      <artifactId>ifmap-core</artifactId>
    </dependency>

    <!-- 声明在 provider-jdbc 之前：让 spring-jdbc 解析为 Spring Framework 6.2.x（SB3 同族），
         而不是 ifmap-provider-jdbc 的 5.3 编译基线。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>
    <dependency>
      <groupId>cn.cj</groupId>
      <artifactId>ifmap-provider-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.cj</groupId>
      <artifactId>ifmap-json-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <version>${spring-boot.version}</version>
    </dependency>

    <!-- 可选：classpath 里有 Caffeine 就用它，没有则退回 core 的 InMemoryConfigCache -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
      <version>${caffeine.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- 编译期生成 spring-configuration-metadata.json（IDE 提示 ifmap.* 配置） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <version>${spring-boot.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring-boot.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
    <!-- 测试库开关：默认 H2，设 IFMAP_JDBC_URL 后可跑真 MySQL（同 ifmap-provider-jdbc） -->
    <dependency>
      <groupId>cn.cj</groupId>
      <artifactId>ifmap-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
