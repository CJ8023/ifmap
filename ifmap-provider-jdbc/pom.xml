<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>cn.cj</groupId>
    <artifactId>ifmap-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ifmap-provider-jdbc</artifactId>
  <name>ifmap-provider-jdbc</name>
  <description>ifmap 的 JDBC 配置仓储实现：MySQL 建表脚本 + Liquibase changelog + JdbcTemplate 仓储（JDK8 基线）</description>

  <dependencies>
    <dependency>
      <groupId>cn.cj</groupId>
      <artifactId>ifmap-core</artifactId>
    </dependency>
    <!-- 版本在此就地声明（不放父 pom 的 dependencyManagement）：
         保证 Spring Boot 3 项目里能被 spring-boot-starter-jdbc 的 spring-jdbc 6.2.x 就近覆盖。
         本模块只用到 query(String, RowMapper, Object...) / update(String, Object...)，
         这些 API 在 Spring 5.3 与 6.2 上都存在，故 5.3 编译基线在 SB3 上运行安全。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>${spring-jdbc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
    </dependency>
  </dependencies>
</project>
